{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "composite": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "@pkg/core": ["../../packages/core/types/index.d.ts"],
      "@pkg/core/*": ["../../packages/core/types/*.d.ts"],
      "@pkg/cache": ["../../packages/cache/src/index.ts"],
      "@pkg/cache/*": ["../../packages/cache/src/*"],
      "@pkg/meteo-providers": ["../../packages/meteo-providers/types/index.d.ts"],
      "@pkg/meteo-providers/*": ["../../packages/meteo-providers/types/*.d.ts"],
      "@pkg/insight-engine": ["../../packages/insight-engine/types/index.d.ts"],
      "@pkg/insight-engine/*": ["../../packages/insight-engine/types/*.d.ts"],
      "@pkg/meteo-calcs": ["../../packages/meteo-calcs/types/index.d.ts"],
      "@pkg/meteo-calcs/*": ["../../packages/meteo-calcs/types/*.d.ts"]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "dist"
  ],
  "references": [
    { "path": "../../packages/core" },
    { "path": "../../packages/cache" },
    { "path": "../../packages/meteo-calcs" },
    { "path": "../../packages/meteo-providers" },
    { "path": "../../packages/insight-engine" }
  ]
}
