{
  "name": "tendencia-lluvias",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "build": "pnpm -r run build",
    "build:packages": "pnpm -r --filter \"@pkg/*\" --workspace-concurrency=1 --sort run build",
    "build:server": "pnpm run build:packages && pnpm --filter api run build",
    "build:render": "pnpm run build:server",
    "test": "pnpm -r run test --filter './packages/**'",
    "codex:cli": "node ./scripts/codex-cli.js",
    "codex:preview": "node ./scripts/codex-cli.js preview",
    "codex:apply": "node ./scripts/codex-cli.js apply"
  },
  "devDependencies": {
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.0",
    "vitest": "^1.6.0"
  }
}
