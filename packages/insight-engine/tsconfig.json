{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@pkg/core": ["../core/types/index.d.ts"],
      "@pkg/core/*": ["../core/types/*.d.ts"],
      "@pkg/meteo-calcs": ["../meteo-calcs/types/index.d.ts"],
      "@pkg/meteo-calcs/*": ["../meteo-calcs/types/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist"],
  "references": [{ "path": "../core" }, { "path": "../meteo-calcs" }]
}
