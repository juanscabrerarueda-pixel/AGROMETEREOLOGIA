{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@pkg/core": ["../core/types/index.d.ts"],
      "@pkg/core/*": ["../core/types/*.d.ts"],
      "@pkg/core/schemas": ["../core/types/schemas.d.ts"],
      "@pkg/core/schemas.js": ["../core/types/schemas.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"],
  "exclude": ["dist"],
  "references": [{ "path": "../core" }]
}
